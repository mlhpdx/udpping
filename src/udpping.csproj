<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UdpPingGraph</RootNamespace>
    <AssemblyName>udpping</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Native AOT -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <EventSourceSupport>false</EventSourceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <StackTraceSupport>false</StackTraceSupport>

    <Authors>Lee Harding</Authors>
    <Product>udpping</Product>
    <Description>A `gping`-style latency grapher that probes over plain UDP echo (RFC 862) instead of ICMP.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
  </ItemGroup>

</Project>
